# Redmi AC2100 (RM2100) sparse seed config
# Official upstream OpenWrt v25.12.5; ramips/mt7621; 128 MiB RAM; IPv4-only.
# Required role: PPPoE + dual-band AP + SSH + ShellCrash nftables TProxy + DNS/DHCP + ZRAM.
# This is deliberately a sparse seed. `make defconfig` resolves target dependencies/defaults.

CONFIG_TARGET_ramips=y
CONFIG_TARGET_ramips_mt7621=y
CONFIG_TARGET_ramips_mt7621_DEVICE_xiaomi_redmi-router-ac2100=y
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_CCACHE=y

# IPv6 MUST be absent from both userspace config and the built Linux kernel.
# CONFIG_IPV6 is not set
# CONFIG_PACKAGE_kmod-ipv6 is not set
# CONFIG_PACKAGE_kmod-ip6tables is not set
# CONFIG_PACKAGE_ip6tables-nft is not set
# CONFIG_PACKAGE_ip6tables-zz-legacy is not set
# CONFIG_PACKAGE_ip6tables-extra is not set
# CONFIG_PACKAGE_kmod-nf-conntrack6 is not set
# CONFIG_PACKAGE_kmod-nf-nat6 is not set
# CONFIG_PACKAGE_kmod-ipt-nat6 is not set
# CONFIG_PACKAGE_ipv6helper is not set
# CONFIG_PACKAGE_odhcp6c is not set
# CONFIG_PACKAGE_odhcpd is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set
# CONFIG_PACKAGE_luci-proto-ipv6 is not set
# CONFIG_PACKAGE_dnsmasq_full_dhcpv6 is not set

# Management and download tools. These are not persistent daemons.
# Keep curl: ShellCrash requires curl or wget for install/update and node operations;
# uclient-fetch is not a drop-in replacement for curl.
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_ca-bundle=y
CONFIG_PACKAGE_dropbear=y
CONFIG_DROPBEAR_SCP=y
CONFIG_PACKAGE_ip-tiny=y
# CONFIG_PACKAGE_ip-full is not set
CONFIG_PACKAGE_uclient-fetch=y

# RM2100 has no USB port and uses a SquashFS/UBI system; forbid unused storage drivers.
# These guards save flash if a target default ever tries to select them; unloaded modules
# do not consume 1-2 MiB of resident RAM, so do not count them as a RAM optimization.
# CONFIG_PACKAGE_kmod-usb-core is not set
# CONFIG_PACKAGE_kmod-usb2 is not set
# CONFIG_PACKAGE_kmod-usb3 is not set
# CONFIG_PACKAGE_kmod-usb-storage is not set
# CONFIG_PACKAGE_kmod-scsi-core is not set
# CONFIG_PACKAGE_kmod-fs-ext4 is not set
# CONFIG_PACKAGE_kmod-fs-vfat is not set
# CONFIG_PACKAGE_kmod-nls-base is not set

# IPv4 DNS/DHCP. Keep DNS nftset integration, remove unused dnsmasq features.
CONFIG_PACKAGE_dnsmasq-full=y
CONFIG_PACKAGE_dnsmasq_full_dhcp=y
CONFIG_PACKAGE_dnsmasq_full_nftset=y
# CONFIG_PACKAGE_dnsmasq_full_dhcpv6 is not set
# CONFIG_PACKAGE_dnsmasq_full_dnssec is not set
# CONFIG_PACKAGE_dnsmasq_full_auth is not set
# CONFIG_PACKAGE_dnsmasq_full_conntrack is not set
# CONFIG_PACKAGE_dnsmasq_full_ipset is not set
# CONFIG_PACKAGE_dnsmasq_full_tftp is not set

# OpenWrt 25.12 uses firewall4/nftables. ShellCrash must be configured for nftables + TProxy.
CONFIG_PACKAGE_firewall4=y
CONFIG_PACKAGE_nftables-json=y
CONFIG_PACKAGE_kmod-nft-core=y
CONFIG_PACKAGE_kmod-nft-conntrack=y
CONFIG_PACKAGE_kmod-nft-nat=y
CONFIG_PACKAGE_kmod-nft-socket=y
CONFIG_PACKAGE_kmod-nft-tproxy=y
CONFIG_PACKAGE_kmod-nf-conntrack=y
CONFIG_PACKAGE_kmod-nf-nat=y
CONFIG_PACKAGE_kmod-nf-tproxy=y
# Do not include parallel iptables backend packages.
# CONFIG_PACKAGE_iptables-nft is not set
# CONFIG_PACKAGE_iptables-zz-legacy is not set
# CONFIG_PACKAGE_iptables-mod-tproxy is not set
# CONFIG_PACKAGE_iptables-mod-socket is not set

# PPPoE WAN.
CONFIG_PACKAGE_ppp=y
CONFIG_PACKAGE_ppp-mod-pppoe=y
CONFIG_PACKAGE_kmod-ppp=y
CONFIG_PACKAGE_kmod-pppoe=y
CONFIG_PACKAGE_kmod-pppox=y
CONFIG_PACKAGE_kmod-slhc=y

# RM2100 radios: MT7603 2.4 GHz + MT7615 5 GHz.
CONFIG_PACKAGE_wpad-basic-mbedtls=y
CONFIG_PACKAGE_kmod-mac80211=y
CONFIG_PACKAGE_kmod-cfg80211=y
CONFIG_PACKAGE_kmod-mt76-core=y
CONFIG_PACKAGE_kmod-mt7603=y
CONFIG_PACKAGE_kmod-mt7615e=y
CONFIG_PACKAGE_kmod-mt7615-firmware=y

# ZRAM. OpenWrt zram-swap depends on these BusyBox applets.
CONFIG_PACKAGE_kmod-zram=y
CONFIG_PACKAGE_zram-swap=y
CONFIG_BUSYBOX_CONFIG_FEATURE_SWAPON_DISCARD=y
CONFIG_BUSYBOX_CONFIG_FEATURE_SWAPON_PRI=y
CONFIG_BUSYBOX_CONFIG_MKSWAP=y
CONFIG_BUSYBOX_CONFIG_SWAPOFF=y
CONFIG_BUSYBOX_CONFIG_SWAPON=y
CONFIG_BUSYBOX_CONFIG_CHPASSWD=y

# Keep the cron applets for ShellCrash scheduled jobs without adding a second cron implementation.
# Do not bulk-prune BusyBox applets: most savings are flash-only and uncertain applets
# can break diagnostics, ShellCrash scripts or package-maintenance workflows.
CONFIG_BUSYBOX_CONFIG_CROND=y
CONFIG_BUSYBOX_CONFIG_CRONTAB=y

# No LuCI/RPC/web server. Keep core OpenWrt services and diagnostics enabled.
# CONFIG_PACKAGE_luci is not set
# CONFIG_PACKAGE_luci-base is not set
# CONFIG_PACKAGE_rpcd is not set
# CONFIG_PACKAGE_uhttpd is not set
# CONFIG_PACKAGE_uhttpd-mod-ubus is not set
# CONFIG_PACKAGE_odhcpd is not set
# CONFIG_PACKAGE_odhcpd-ipv6only is not set

# Do not patch CPU PLL, IRQ affinity, DTS MAC labels, or HNAT/flow-offload code.
# Do not override OpenWrt's default memory watermarks or TCP buffer policy before measurement.
